{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "printWidth": 80,
  "trailingComma": "all",
  "singleQuote": true,
  "ignorePatterns": [
    ".cottontail-tmp/**",
    "src/components/ui/**",
    "src/db/migrations/meta/**",
    "tools/oxlint/**"
  ],
  "sortTailwindcss": {},
  "sortPackageJson": false
}
