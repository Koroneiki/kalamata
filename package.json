{
  "name": "kalamata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite build && electrobun dev",
    "dev": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "vite --port 5173",
    "build": "vite build && electrobun build --env=stable",
    "test": "bun test",
    "test:integration": "STEAM_INTEGRATION=1 bun test test/balatro-download.integration.test.ts",
    "test:integration:cat-quest": "CAT_QUEST_INTEGRATION=1 bun test test/cat-quest-download.integration.test.ts",
    "test:integration:grow-home": "GROW_HOME_INTEGRATION=1 bun test test/grow-home-download.integration.test.ts",
    "typecheck": "bunx vue-tsc --noEmit && bunx tsc --noEmit -p tsconfig.backend.json"
  },
  "dependencies": {
    "@napi-rs/lzma": "1.5.1",
    "adm-zip": "0.5.18",
    "electrobun": "1.18.1",
    "steam-user": "5.3.0",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/steam-user": "5.1.1",
    "@types/three": "0.165.0",
    "@vitejs/plugin-vue": "6.0.8",
    "concurrently": "10.0.3",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vue-tsc": "3.3.7"
  }
}
