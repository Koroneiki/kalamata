{
  "name": "kalamata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite build && electrobun dev",
    "dev": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "vite --port 5173",
    "build:assets": "vite build && bun scripts/build-decompress-worker.ts",
    "build": "vite build && electrobun build --env=stable",
    "test": "bun test",
    "test:integration": "STEAM_INTEGRATION=1 bun test test/balatro-download.integration.test.ts",
    "test:integration:cat-quest": "CAT_QUEST_INTEGRATION=1 bun test test/cat-quest-download.integration.test.ts",
    "test:integration:grow-home": "GROW_HOME_INTEGRATION=1 bun test test/grow-home-download.integration.test.ts",
    "type-check": "vue-tsc --build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fallow": "fallow"
  },
  "dependencies": {
    "@doctormckay/steam-crypto": "1.2.0",
    "@lucide/vue": "^1.31.0",
    "@napi-rs/lzma": "1.5.1",
    "@pinia/colada": "^1.4.2",
    "@vueuse/core": "^14.4.0",
    "adm-zip": "0.5.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "electrobun": "1.18.1",
    "pinia": "^4.0.2",
    "reka-ui": "^2.10.3",
    "steam-user": "5.3.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vue": "3.5.40",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node22": "^22.0.5",
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "@types/steam-user": "5.1.1",
    "@types/three": "0.165.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "10.0.3",
    "drizzle-kit": "^0.31.10",
    "fallow": "3.6.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "3.3.7"
  }
}
