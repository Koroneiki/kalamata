{
  "name": "kalamata",
  "version": "1.0.2",
  "private": true,
  "packageManager": "bun@1.4.0",
  "type": "module",
  "scripts": {
    "start": "electrobun prepare && bun run start:prepared",
    "start:prepared": "vite build && bun scripts/build-decompress-worker.ts && electrobun dev",
    "dev": "electrobun prepare && concurrently \"bun run hmr\" \"bun run start:prepared\"",
    "hmr": "vite --port 5173",
    "build:assets": "electrobun prepare && vite build && bun scripts/build-decompress-worker.ts",
    "build": "electrobun prepare && vite build && bun scripts/build-decompress-worker.ts && electrobun build --env=stable",
    "test": "bun test",
    "type-check": "electrobun prepare && vue-tsc --build",
    "lint": "electrobun prepare && oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fallow": "fallow"
  },
  "dependencies": {
    "@lucide/vue": "^1.46.0",
    "@napi-rs/lzma": "1.5.1",
    "@pinia/colada": "^1.4.4",
    "@vueuse/core": "^14.4.0",
    "adm-zip": "0.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "steam-user": "5.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "3.5.42",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.83.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/bun": "latest",
    "@types/node": "^26.5.1",
    "@types/steam-user": "5.1.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "10.0.5",
    "drizzle-kit": "^0.31.10",
    "electrobun": "2.0.1",
    "fallow": "3.25.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "3.3.11"
  }
}
